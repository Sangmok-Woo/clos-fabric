#!/bin/bash
# FRR 이미지의 /usr/lib/frr/docker-start 와 같고, watchfrr 의 재시작 간격만 고정했다.
# 기본값(min 60초, max 600초)은 재시작이 20분 안에 되풀이되면 간격을 두 배씩 늘린다(60→120→240초…).
# 실험에서 bgpd 를 여러 번 죽이므로 매번 같은 조건이 되게 --min-restart-interval 2 --max-restart-interval 4 로 둔다 (Phase 사이는 8초보다 길다).
log_success_msg() { echo "$@"; }
log_warning_msg() { echo "$@" >&2; }
log_failure_msg() { echo "$@" >&2; }
source /usr/lib/frr/frrcommon.sh
/usr/lib/frr/watchfrr --min-restart-interval 2 --max-restart-interval 4 $(daemon_list)

{
  "uid": "clos-fabric",
  "title": "clos-fabric — 패브릭 상태",
  "tags": ["clos", "bgp"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Established 세션 (전체)",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PROM_CLOS" },
      "targets": [
        { "refId": "A", "expr": "sum(clos_bgp_peers_established)", "legendFormat": "established" },
        { "refId": "B", "expr": "sum(clos_bgp_peers_expected)", "legendFormat": "expected" }
      ],
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 16 } ] } }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "기대 미달 노드 수",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PROM_CLOS" },
      "targets": [
        { "refId": "A", "expr": "count(clos_bgp_peers_established < clos_bgp_peers_expected) or vector(0)" }
      ],
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "발생 중 알람",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PROM_CLOS" },
      "targets": [
        { "refId": "A", "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)" }
      ],
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "BFD up (전체)",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PROM_CLOS" },
      "targets": [
        { "refId": "A", "expr": "sum(clos_bfd_peers_up) or vector(0)" }
      ],
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "steps": [ { "color": "blue", "value": null } ] } }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "노드별 Established 세션",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "PROM_CLOS" },
      "targets": [
        { "refId": "A", "expr": "clos_bgp_peers_established", "legendFormat": "{{node}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "노드별 BGP RIB 경로 수",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "PROM_CLOS" },
      "targets": [
        { "refId": "A", "expr": "clos_bgp_rib_routes", "legendFormat": "{{node}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 7,
      "type": "state-timeline",
      "title": "개별 이웃 up/down",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "PROM_CLOS" },
      "targets": [
        { "refId": "A", "expr": "clos_bgp_peer_up", "legendFormat": "{{node}} → {{peer}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1, "color": { "mode": "thresholds" }, "mappings": [ { "type": "value", "options": { "0": { "text": "down", "color": "red", "index": 0 }, "1": { "text": "up", "color": "green", "index": 1 } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }, "custom": { "fillOpacity": 90 } }, "overrides": [] },
      "options": { "showValue": "never", "mergeValues": true, "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {"id": 10, "type": "row", "title": "데이터플레인 — 세션이 멀쩡해도 데이터가 막히는지", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 22}, "collapsed": false, "panels": []},
    {"id": 11, "type": "stat", "title": "링크 드랍 (최근 1분)", "gridPos": {"h": 5, "w": 6, "x": 0, "y": 23}, "datasource": {"type": "prometheus", "uid": "PROM_CLOS"}, "targets": [{"refId": "A", "expr": "sum((max by (link) (increase(clos_if_rx_dropped_total[1m])) >= max by (link) (increase(clos_if_tx_dropped_total[1m]))) or max by (link) (increase(clos_if_tx_dropped_total[1m])))"}], "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "decimals": 0}, "overrides": []}, "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 12, "type": "stat", "title": "MTU 불일치 패브릭 포트", "gridPos": {"h": 5, "w": 6, "x": 6, "y": 23}, "datasource": {"type": "prometheus", "uid": "PROM_CLOS"}, "targets": [{"refId": "A", "expr": "count(clos_if_mtu{kind=\"fabric\"} != on() group_left() quantile(0.5, clos_if_mtu{kind=\"fabric\"})) or vector(0)"}], "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}, "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 13, "type": "stat", "title": "서버 TCP 재전송 (최근 1분)", "gridPos": {"h": 5, "w": 6, "x": 12, "y": 23}, "datasource": {"type": "prometheus", "uid": "PROM_CLOS"}, "targets": [{"refId": "A", "expr": "sum(increase(clos_host_tcp_retranssegs_total[1m]))"}], "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 50}]}, "decimals": 0}, "overrides": []}, "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 14, "type": "stat", "title": "세션 끊김 (최근 5분)", "gridPos": {"h": 5, "w": 6, "x": 18, "y": 23}, "datasource": {"type": "prometheus", "uid": "PROM_CLOS"}, "targets": [{"refId": "A", "expr": "sum(increase(clos_bgp_peer_drops_total[5m]))"}], "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "decimals": 0}, "overrides": []}, "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 15, "type": "timeseries", "title": "인터페이스별 드랍 (/s)", "gridPos": {"h": 9, "w": 12, "x": 0, "y": 28}, "datasource": {"type": "prometheus", "uid": "PROM_CLOS"}, "targets": [{"refId": "A", "expr": "rate(clos_if_rx_dropped_total[30s]) > 0", "legendFormat": "{{node}}:{{ifname}} RX ({{link}})"}, {"refId": "B", "expr": "rate(clos_if_tx_dropped_total[30s]) > 0", "legendFormat": "{{node}}:{{ifname}} TX ({{link}})"}], "fieldConfig": {"defaults": {"unit": "pps", "min": 0, "custom": {"fillOpacity": 10, "lineWidth": 2}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi"}}},
    {"id": 16, "type": "timeseries", "title": "스파인별 통과 트래픽", "gridPos": {"h": 9, "w": 12, "x": 12, "y": 28}, "datasource": {"type": "prometheus", "uid": "PROM_CLOS"}, "targets": [{"refId": "A", "expr": "sum by (node) (rate(clos_if_tx_bytes_total{role=\"spine\"}[30s])) * 8", "legendFormat": "{{node}}"}], "fieldConfig": {"defaults": {"unit": "bps", "min": 0, "custom": {"fillOpacity": 10, "lineWidth": 2}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi"}}},
    {"id": 17, "type": "timeseries", "title": "서버별 TCP 재전송 (/s)", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 37}, "datasource": {"type": "prometheus", "uid": "PROM_CLOS"}, "targets": [{"refId": "A", "expr": "rate(clos_host_tcp_retranssegs_total[30s])", "legendFormat": "{{host}}"}], "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"fillOpacity": 10, "lineWidth": 2}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi"}}},
    {"id": 18, "type": "timeseries", "title": "패브릭 포트 MTU — 한 줄만 내려가면 불일치", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 37}, "datasource": {"type": "prometheus", "uid": "PROM_CLOS"}, "targets": [{"refId": "A", "expr": "clos_if_mtu{kind=\"fabric\"}", "legendFormat": "{{node}}:{{ifname}}"}], "fieldConfig": {"defaults": {"unit": "short", "min": null, "custom": {"fillOpacity": 10, "lineWidth": 2}}, "overrides": []}, "options": {"legend": {"showLegend": false}, "tooltip": {"mode": "multi"}}}
  ]
}
